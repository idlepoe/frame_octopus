{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "frame-octopus",
          "appId": "1:18444933139:android:03c4c58207011ebdd207e6",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "frame-octopus",
          "configurations": {
            "android": "1:18444933139:android:03c4c58207011ebdd207e6"
          }
        }
      }
    }
  },
  "hosting": {
    "site": "frame-octopus",
    "public": "hosting/public",
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'none'; style-src 'self'; img-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  }
}
